/* ---- Тема звіту: один набір токенів для всіх шарів (підключається останнім) ---- */
:root{--bg:#F1F3F6;--surface:#FFFFFF;--line:#8592A0;--line2:#B3BDC7;--hair:#D6DCE2;--text:#16212B;--mute:#55636F;--accent:#0B5FA5;--accent-soft:#E6EFF8;--positive:#1F6B45;--warn:#8A5A00;--danger:#A13A3A;
 --ink:#16212B;--head:#16212B;--head2:#24313D;--acc:#0B5FA5;--t1:#DAE6F3;--t2:#DCEBDE;--t3:#F3EBCF;--t4:#F5DFD2;--t5:#E7DBEB;--b:#DAE6F3}
html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:var(--text);background:var(--bg)}
a{color:var(--accent);text-underline-offset:3px}
p,li{max-width:76ch}
h2{font-size:26px;line-height:1.2;font-weight:700;letter-spacing:-.015em;margin:0 0 12px;text-wrap:balance}
h3{font-size:20px;line-height:1.3;font-weight:700;color:var(--text);margin:0 0 10px}
h4{font-size:15px;line-height:1.4;font-weight:700;color:var(--text);text-transform:none;letter-spacing:0;margin:18px 0 8px}
.lead{font-size:17px;line-height:1.55;max-width:76ch}
.note,small{font-size:14px;line-height:1.5}.note{color:var(--mute)}
/* шапка і навігація */
header{background:var(--text);color:#fff;padding:12px 28px;gap:14px 28px;box-shadow:none;border-bottom:3px solid var(--accent)}
header h1{font-size:17px;font-weight:700;line-height:1.3}header .sub{font-size:13px;opacity:.75}
nav{display:flex;gap:2px;flex-wrap:wrap}nav a{color:#fff;border:0;border-bottom:3px solid transparent;border-radius:0;padding:8px 10px;font-size:14px;font-weight:600;margin:0}
nav a:hover{background:rgba(255,255,255,.1)}nav a.on{background:transparent;color:#fff;border-bottom-color:#fff;font-weight:700}
main{max-width:1500px;padding:28px 32px 80px}
/* герой розділу: плоска поверхня з акцентною смугою */
.hero{background:var(--surface);color:var(--text);border:1.5px solid var(--line);border-left:7px solid var(--accent);border-radius:10px;padding:28px 30px;margin:0 0 26px;box-shadow:none}
.hero h2{color:var(--text);font-size:30px;line-height:1.15;font-weight:750;margin:0 0 10px}
.hero p{font-size:17px;line-height:1.55;opacity:1;max-width:76ch;color:var(--text)}
.hero .strip{margin:18px 0 0;gap:12px}
.hero .kpi{background:var(--bg);border:1.5px solid var(--line2);color:var(--text);border-radius:6px}.hero .kpi small{color:var(--mute)}
.hero .legend{margin-top:16px}.hero .legend span{background:var(--bg);border:1px solid var(--line2);color:var(--text)}
.hero .legend span.T1{background:var(--t1)}.hero .legend span.T2{background:var(--t2)}.hero .legend span.T3{background:var(--t3)}.hero .legend span.T4{background:var(--t4)}.hero .legend span.T5{background:var(--t5)}.hero .legend span.D{background:var(--danger);color:#fff;border-color:var(--danger)}
/* поверхні */
.card{background:var(--surface);border:1.5px solid var(--line);border-radius:10px;padding:24px 26px;margin:0 0 22px;box-shadow:none}
.kpi{background:var(--surface);border:1.5px solid var(--line2);border-radius:6px;padding:14px 16px;min-width:160px}.kpi b{font-size:28px;line-height:1.1;font-weight:750;letter-spacing:-.01em}.kpi small{color:var(--mute);margin-top:4px;font-size:14px}
.kpi.txt b{font-size:15px;line-height:1.35;font-weight:650}.kpi.txt{min-width:200px}
.ccard{background:var(--surface);border:1.5px solid var(--line2);border-left:5px solid var(--accent);border-radius:6px;padding:16px 18px;gap:14px}.ccard p{font-size:16px;line-height:1.55}.ccard small{font-size:14px;color:var(--mute);margin-top:6px}
.ccard.dec{background:#FBF6F0;border-color:#D9B98F;border-left-color:var(--warn)}.cn{background:var(--accent);width:30px;height:30px;font-size:14px}.ccard.dec .cn{background:var(--warn)}
.sl{background:var(--surface);border:1.5px solid var(--line2);border-radius:6px;padding:14px 16px}.sl:hover{border-color:var(--accent);background:var(--accent-soft)}.sl b{color:var(--accent);font-size:16px}.sl span{font-size:14.5px;color:var(--text)}
.acc{border:1.5px solid var(--line2);border-radius:6px;background:var(--surface);margin:12px 0;box-shadow:none}.acc summary{padding:13px 16px;min-height:50px}.acc summary:hover{background:var(--accent-soft)}
.at{font-size:16px;font-weight:700;line-height:1.4}.as{font-size:14px;color:var(--mute)}.ab{padding:8px 18px 20px;border-top:1px solid var(--hair)}.chev{border-color:var(--accent)}
article.proc details:not(.acc){border:1.5px solid var(--line2);border-radius:6px;background:var(--surface)}
.ptitle h2{font-size:28px}
.ptitle .strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}.ptitle .kpi{min-width:0}
.v5 .strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px}.v5 .kpi{min-width:0}
/* бічна панель і фільтри */
.layout{grid-template-columns:320px minmax(0,1fr);gap:24px}
aside{background:var(--surface);border:1.5px solid var(--line2);border-radius:10px;padding:14px;top:88px;max-height:calc(100vh - 110px)}
aside input,aside select,#fq,.filters input,.filters select{min-height:40px;padding:8px 11px;border:1.5px solid var(--line2);border-radius:6px;font:inherit;font-size:15px;color:var(--text);background:var(--surface)}
aside input:focus,aside select:focus,#fq:focus,.filters input:focus,.filters select:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:var(--accent)}
.filters .cnt{font-size:14px}
.plist a{padding:9px 10px;border-radius:0;border-left:4px solid transparent;font-size:14.5px;line-height:1.35;color:var(--text)}.plist a:hover{background:var(--accent-soft)}.plist a.on{background:var(--accent-soft);border-left-color:var(--accent);font-weight:700}
.chip{font-size:12.5px;padding:2px 9px;border:1px solid rgba(22,33,43,.14);font-weight:600}
/* таблиці */
