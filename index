.0,257.0 H437" class="edge hand" marker-end="url(#arh)"/><path d="M653,257.0 H707" class="edge" marker-end="url(#ar)"/><path d="M923,257.0 H941.0 Q951.0,257.0 951.0,267.0 V539.0 Q951.0,549.0 961.0,549.0 H977" class="edge hand" marker-end="url(#arh)"/><path d="M1193,549.0 H1211.0 Q1221.0,549.0 1221.0,559.0 V685.0 Q1221.0,695.0 1231.0,695.0 H1247" class="edge hand" marker-end="url(#arh)"/><path d="M1463,695.0 H1481.0 Q1491.0,695.0 1491.0,685.0 V267.0 Q1491.0,257.0 1501.0,257.0 H1517" class="edge hand" marker-end="url(#arh)"/><path d="M1733,257.0 H1751.0 Q1761.0,257.0 1761.0,267.0 V831.0 Q1761.0,841.0 1771.0,841.0 H1787" class="edge hand" marker-end="url(#arh)"/><path d="M2003,841.0 H2021.0 Q2031.0,841.0 2031.0,831.0 V267.0 Q2031.0,257.0 2041.0,257.0 H2057" class="edge hand" marker-end="url(#arh)"/><path d="M2273,257.0 H2291.0 Q2301.0,257.0 2301.0,247.0 V121.0 Q2301.0,111.0 2311.0,111.0 H2327" class="edge hand" marker-end="url(#arh)"/><path d="M2543,111.0 H2561.0 Q2571.0,111.0 2571.0,121.0 V247.0 Q2571.0,257.0 2581.0,257.0 H2597" class="edge hand" marker-end="url(#arh)"/><path d="M2813,257.0 H2831.0 Q2841.0,257.0 2841.0,267.0 V831.0 Q2841.0,841.0 2851.0,841.0 H2867" class="edge hand" marker-end="url(#arh)"/><path d="M3083,841.0 H3101.0 Q3111.0,841.0 3111.0,831.0 V267.0 Q3111.0,257.0 3121.0,257.0 H3137" class="edge hand" marker-end="url(#arh)"/><path d="M3353,257.0 H3371.0 Q3381.0,257.0 3381.0,267.0 V831.0 Q3381.0,841.0 3391.0,841.0 H3407" class="edge hand" marker-end="url(#arh)"/><path d="M3623,841.0 H3641.0 Q3651.0,841.0 3651.0,831.0 V705.0 Q3651.0,695.0 3661.0,695.0 H3677" class="edge hand" marker-end="url(#arh)"/><path d="M3893,695.0 H3911.0 Q3921.0,695.0 3921.0,685.0 V267.0 Q3921.0,257.0 3931.0,257.0 H3947" class="edge hand" marker-end="url(#arh)"/></svg></div><div class="ctl-inline"><span class="rl">Людина лишається</span><ul class="clean cols2"><li><b>Керівник проєкту (PM)</b> — Визначає потребу і технічне завдання; бере участь в оцінюванні без права голосу</li><li><b>Закупівельник</b> — Готує документацію з профільним спеціалістом і оприлюднює тендер</li><li><b>Тендерний комітет</b> — Підписує декларації, оцінює незалежно, підписує протокол</li><li><b>Погоджувачі протоколу (керівник проєкту, CFO; CIO або Comms Lead за предметом)</b> — Погоджують протокол у Вчасно</li><li><b>Голова правління</b> — Затверджує склад комітету і підписує протокол</li></ul></div></div>
<details class="acc" open><summary><span class="chev"></span><span class="at">Що заважає зараз</span><span class="as">2 розриви</span></summary><div class="ab"><div class="gaps"><div class="gap">Процес триває близько 20 робочих днів, а корисна робота становить 4,3 % часу, тому більшість часу припадає на очікування.</div><div class="gap">Склад комітету і правління та критерії погодження відрізняються від гайда, тому правомочність рішення може трактуватися неоднаково.</div></div><p class="note cardfix"><b>Виправити у картці:</b> у джерелі суми позначено у доларах («&gt;$2.5M»); назву і пороги подано за Положенням 2026 у гривнях.</p></div></details>
<details class="acc" open><summary><span class="chev"></span><span class="at">Що налаштувати</span><span class="as">4 рішення · 8 кроків · 3 показники</span></summary><div class="ab"><h4>Рішення, потрібні перед налаштуванням</h4><div class="dgrid"><div class="dcard"><span class="dn">1</span><div><b>Склад тендерного комітету і роль Голови правління</b><p>Постійний склад наказом чи окремий на кожен тендер; чи входить Голова правління до комітету (у картці — фінальне затвердження, у гайді — підпис протоколу).</p></div></div><div class="dcard"><span class="dn">2</span><div><b>Канал приймання пропозицій</b><p>Запит файлів OneDrive (потрібен дозвіл адміністратора) чи скринька закупівель; для двоетапного тендеру — окреме подання комерційної частини.</p></div></div><div class="dcard"><span class="dn">3</span><div><b>Порогова сума тендеру</b><p>Поріг тендеру 2,5 млн грн — п. 1.11 чинного Положення (редакція від 26.05.2026); попередня редакція 2025 з порогом 1,6 млн грн втратила чинність за наказом № 36-о.</p></div></div><div class="dcard"><span class="dn">4</span><div><b>Місце оприлюднення і правила на випадок рівності голосів</b><p>Сайт організації чи майданчик; що робити при рівності голосів і якщо членів з правом голосу менше трьох.</p></div></div></div><h4>Кроки налаштування</h4><div class="stepper"><div class="ph">Основа</div><div class="st"><div class="sn" style="background:#038387">1</div><div class="sb"><b>Реєстр процедур і шаблонна тека у SharePoint</b><p>Список процедур (склад комітету, строки, статуси) і тека-шаблон з підтеками для оголошення, пропозицій, оцінок, протоколу.</p><div class="meta"><span class="tb"><span class="tm" style="background:#038387">Li</span><span>Lists</span></span><span class="tb"><span class="tm" style="background:#036C70">SP</span><span>SharePoint</span></span><span class="chip">Хто: адміністратор Microsoft 365 + закупівлі</span><span class="chip pre">Передумова: рішення 1</span><span class="chip eff">Трудомісткість: 1 день</span></div><div class="chk"><span class="rl">Перевірка</span>Нова процедура отримує теку зі структурою і запис зі строками</div></div></div><div class="st"><div class="sn" style="background:#038387">2</div><div class="sb"><b>Форма оцінювання для членів комітету</b><p>Список «Оцінки» з критеріями Положення, полем голосу і вбудованою формою; доступ до кожного запису до завершення оцінювання — лише його автору й адміністратору процесу.</p><div class="meta"><span class="tb"><span class="tm" style="background:#038387">Li</span><span>Lists</span></span><span class="chip">Хто: адміністратор Microsoft 365</span><span class="chip pre">Передумова: критерії за рішенням закупівель</span><span class="chip eff">Трудомісткість: 0,5 дня</span></div><div class="chk"><span class="rl">Перевірка</span>Три тестові оцінки зводяться в підсумок без ручного підрахунку; член комітету не бачить чужих записів</div></div></div><div class="st"><div class="sn" style="background:#2B579A">3</div><div class="sb"><b>Шаблони декларації, протоколу та оголошення</b><p>Шаблони Word з полями за Положенням (елементи оголошення — п. 3.2.1; протокол — склад, голосування, переможець).</p><div class="meta"><span class="tb"><span class="tm" style="background:#2B579A">W</span><span>Word</span></span><span class="chip">Хто: закупівлі + юрист</span><span class="chip eff">Трудомісткість: 1 день</span></div><div class="chk"><span class="rl">Перевірка</span>Документи з тестових даних формуються без правок</div></div></div><div class="ph">Автоматизація</div><div class="st"><div class="sn" style="background:#038387">4</div><div class="sb"><b>Автоматизація «Новий тендер»</b><p>За типом процедури — копія теки, запис у реєстрі процедур, строки за Положенням, повідомлення закупівельнику.</p><div class="meta"><span class="tb"><span class="tm" style="background:#038387">Li</span><span>Lists</span></span><span class="tb"><span class="tm" style="background:#0066FF">PA</span><span>Power Automate</span></span><span class="tb"><span class="tm" style="background:#036C70">SP</span><span>SharePoint</span></span><span class="chip">Хто: адміністратор Microsoft 365</span><span class="chip pre">Передумова: кроки 1–3</span><span class="chip eff">Трудомісткість: 1 день</span></div><div class="chk"><span class="rl">Перевірка</span>Запит від 2,5 млн грн створює простір тендеру за хвилину</div></div></div><div class="st"><div class="sn" style="background:#0F6CBD">5</div><div class="sb"><b>Приймання пропозицій і нагадування</b><p>Запит файлів у теку пропозицій, реєстрація кожного файла записом з датою, журнал уточнень зі скриньки закупівель, нагадування за 3 дні і за день.</p><div class="meta"><span class="tb"><span class="tm" style="background:#0F6CBD">Ou</span><span>Outlook</span></span><span class="tb"><span class="tm" style="background:#038387">Li</span><span>Lists</span></span><span class="tb"><span class="tm" style="background:#0066FF">PA</span><span>Power Automate</span></span><span class="tb"><span class="tm" style="background:#0364B8">OD</span><span>OneDrive</span></span><span class="chip">Хто: адміністратор Microsoft 365</span><span class="chip pre">Передумова: рішення 2; дозвіл запитів файлів</span><span class="chip eff">Трудомісткість: 1 день</span></div><div class="chk"><span class="rl">Перевірка</span>Тестова пропозиція з&#x27;являється записом з датою; нагадування надходять у строк</div></div></div><div class="st"><div class="sn" style="background:#1F4B6E">6</div><div class="sb"><b>Автоматизація «Строк минув»</b><p>Перевірка кількості пропозицій, розсилка форм оцінювання, зведення балів, декларації і протокол у Вчасно з маршрутом і підписантами.</p><div class="meta"><span class="tb"><span class="tm" style="background:#1F4B6E">Вч</span><span>Вчасно</span></span><span class="tb"><span class="tm" style="background:#0066FF">PA</span><span>Power Automate</span></span><span class="tb"><span class="tm" style="background:#2B579A">W</span><span>Word</span></span><span class="chip">Хто: адміністратор Microsoft 365 + адміністратор Вчасно</span><span class="chip pre">Передумова: тариф «Інтеграція»; облікові записи членів комітету</span><span class="chip eff">Трудомісткість: 3 дні</span></div><div class="chk"><span class="rl">Перевірка</span>Після строку комітет отримує форми, після оцінок — протокол на підпис без ручного кроку</div></div></div><div class="ph">Контроль і пілот</div><div class="st"><div class="sn" style="background:#7B61FF">7</div><div class="sb"><b>Агент контрольних переліків</b><p>Агент з реєстру організації налаштовується на Положення і шаблони; результат — чернетка переліку і оголошення у теці процедури.</p><div class="meta"><span class="tb"><span class="tm" style="background:#7B61FF">Cp</span><span>Copilot</span></span><span class="chip">Хто: закупівлі + адміністратор Power Platform</span><span class="chip pre">Передумова: включення до реєстру ШІ-агентів; кредити Copilot</span><span class="chip eff">Трудомісткість: 2 дні</span></div><div class="chk"><span class="rl">Перевірка</span>Для тестового предмета агент дає перелік з усіма елементами п. 3.2.1</div></div></div><div class="st"><div class="sn" style="background:#6B7280">8</div><div class="sb"><b>Пілот на першому тендері</b><p>Вимірюються дії людей на процедуру і час від запиту до підписаного протоколу; правила коригуються.</p><div class="meta"><span class="chip">Хто: закупівлі</span><span class="chip pre">Передумова: усе вище</span><span class="chip eff">Трудомісткість: 2 дні супроводу</span></div><div class="chk"><span class="rl">Перевірка</span>Жодного ручного зведення балів і листування про підписи</div></div></div></div><h4>Як зрозуміти, що працює</h4><div class="vgrid"><div class="vcard"><b>≥ 2</b><span>пропозицій перевіряє система до початку оцінювання (Положення, п. 3.2.3)</span></div><div class="vcard"><b>0</b><span>ручних зведень балів і листів про підписи декларацій та протоколу</span></div><div class="vcard"><b>100 %</b><span>декларацій і протоколів з КЕП у Вчасно, тека процедури готова до запиту донора</span></div></div></div></details>
<details class="acc" open><summary><span class="chev"></span><span class="at">Вибір інструментів: чому саме ці, а не інші</span><span class="as">4 рішення · рекомендовано B — автоматизація документів і маршрутів</span></summary><div class="ab"><p class="sub">Для кожної ключової системи процесу: що обрано, які альтернативи розглянуто і чому відхилено, на які факти спирається вибір і що змінило б рішення.</p><div class="scroller"><table class="feas pc"><tr><th>Що вирішуємо</th><th>Обрано</th><th>Альтернативи і чому ні</th><th>Чому саме це</th><th>Що змінило б рішення</th></tr><tr><td><b>Реєстри процедури, пропозицій та оцінок</b></td><td>Microsoft Lists (форми зі списку, права на рівні записів)</td><td><ul class="clean"><li><b>JSM</b> — закупівля — не сервісний запит: комітет, пропозиції й оцінки не вкладаються у формат запиту JSM</li><li><b>Таблиця (у картці не названа)</b> — без версій, прав і строків</li><li><b>Бібліотека SharePoint</b> — документи — так, структуровані оцінки і кворум — ні</li></ul></td><td>Форми оцінювання за фіксованою схемою, приватність оцінок правами на записи, правила нагадувань — без Premium. <span class="fc" title="Форма створюється безпосередньо зі списку Lists (кнопка «Форми» на панелі списку або зі стартової сторінки Lists), а надіслані відповіді одразу стають записами списку без Power Automate; для одного списку можна створити ">F052</span><span class="fc" title="Правила Lists надсилають пошту при створенні чи зміні запису, зміні значення стовпця або наближенні дати.">F053</span><span class="fc" title="Запит на погодження скасовується автоматично, якщо запис списку відредаговано або видалено (Lists попереджає перед збереженням); після скасування поля погодження у списку очищаються повністю, а скасований запит видно лиш">F105</span></td><td>Рішення оголошувати процедури на електронному майданчику (п. 1.14 Положення) — тоді приймання пропозицій переходить на майданчик, реєстр лишається.</td></tr><tr><td><b>Прийом пропозицій учасників</b></td><td>Запит файлів OneDrive і скринька закупівель</td><td><ul class="clean"><li><b>Microsoft Forms</b> — зовнішні учасники не завантажують файли</li><li><b>Електронний майданчик</b> — можливий за Положенням, але потребує окремого рішення і договору з майданчиком</li></ul></td><td>Зовнішні учасники завантажують файли без доступу до теки; лист у скриньку запускає реєстрацію. <span class="fc" title="Завантаження файлів у Microsoft Forms доступне лише для користувачів організації; зовнішні постачальники не можуть завантажити файл через таку форму.">F005</span><span class="fc" title="Запит файлів дає зовнішній особі змогу завантажити файли до вибраної теки за посиланням, не бачачи її вмісту; до назви файла додається ім’я завантажувача.">F056</span><span class="fc" title="Конектор Office 365 Outlook — стандартний; тригер «When a new email arrives (V3)» працює опитуванням і фільтрує за текою, темою та наявністю вкладень; вміст вкладення повертає дія «Get Attachment (V2)».">F107</span></td><td>Рішення про майданчик.</td></tr><tr><td><b>Декларації членів комітету і протокол</b></td><td>Вчасно — підпис КЕП кожного члена окремо</td><td><ul class="clean"><li><b>Approvals eSign</b> — простий підпис; для протоколу комітету, який показують донору, потрібна оцінка юриста</li></ul></td><td>Документи процедури зберігаються 5 років і надаються донору; КЕП у Вчасно — чинна практика. <span class="fc" title="Внутрішнє погодження у Вчасно відбувається без накладення КЕП; порядок може бути послідовним або паралельним, а результати контрагенту не показуються.">F016</span><span class="fc" title="Завантаження документа POST /api/v2/documents приймає параметри внутрішнього погодження (reviewers_ids або reviewers_emails — погоджувачі, parallel_review — паралельно чи почергово, is_required_review — заборона підпису ">F118</span></td><td>Висновок юриста про простий підпис для внутрішніх документів процедури.</td></tr><tr><td><b>Контрольний перелік і чернетка оголошення</b></td><td>Радник Copilot Studio (етап 3, за окремим рішенням)</td><td><ul class="clean"><li><b>Шаблони без агента</b> — працює вже на етапі 2; агент лише пришвидшує підготовку</li></ul></td><td>Агент заземлений на Положенні; чернетку перевіряє закупівельник. <span class="fc" title="Copilot Studio підтримує агентів зі знаннями з SharePoint і файлів, діями через конектори та каналами Teams, Microsoft 365 Copilot і веб, а також робочі процеси й агентні потоки.">F011</span><span class="fc" title="Кредити купують пакетами Copilot Studio або оплачують за використання через підписку Azure; пакет 25 000 кредитів наведений як орієнтовно 200 $ на місяць.">F087</span></td><td>Бюджет кредитів і результат пілоту.</td></tr></table></div><h4>Глибина автоматизації: два варіанти</h4><p class="sub" style="margin-top:10px">Схема «Стало» описує варіант B; кроки 1, 4, 5, 7, 9, 11, 13–14 однакові для обох варіантів.</p><div class="two"><div class="box"><b>Варіант A — вбудовані засоби без автоматизації документів</b><p>Трекер, тека процедури у SharePoint, форми оцінювання у Lists; декларації і протокол закупівельник готує із шаблону вручну, завантажує у Вчасно і призначає підписантів; бали зводить сам.</p></div><div class="box on"><b>Варіант B — з автоматизацією документів, маршрутів у Вчасно і агентом (рекомендований)</b><p>Ті самі рішення людей, але простір процедури, строки, приймання пропозицій, форми оцінювання, зведення балів, декларації і протокол з маршрутом у Вчасно робить автоматизація; агент готує контрольний перелік і чернетку оголошення.</p></div></div><div class="trow wide"><span class="lbl">Що втрачає варіант A</span><span>У варіанті A закупівельник зводить бали, готує документи і призначає підписантів вручну; строки Положення контролюються з пам&#x27;яті.</span></div><div class="trow wide"><span class="lbl">Умова для варіанта A</span><span>Для варіанта B потрібні Power Automate Premium і тариф Вчасно «Інтеграція»; агент впроваджується на етапі 3 плану впровадження (за окремим рішенням організації) після включення до реєстру.</span></div></div></details>
<details class="acc"><summary><span class="chev"></span><span class="at">Правила, враховані у процесі</span><span class="as">10 правил · 4 документи</span></summary><div class="ab"><div class="rgrid"><div class="rule"><div class="rsrc"><span class="rdoc" style="background:#6A1B9A">Положення про порядок здійснення закупівель (редакція від 26.05.2026, наказ № 36-о від 25.05.2026)</span><span class="rref">пп. 1.11, 1.12, розділ 3</span></div><p class="rtxt">Вартісні пороги процедур: до 100 тис. грн — оплата за рахунком; 100 тис.–1 млн — пряма закупівля з обґрунтуванням ціни; 1–2,5 млн — аналіз цін (не менше трьох постачальників); від 2,5 млн грн — тендерна процедура. Якщо договір з донором встановлює інші пороги, застосовуються вони.</p><div class="rapp"><span class="rl">У новому процесі</span><p>Крок 2 визначає тип процедури за сумою з конфігураційного списку порогів; для проєктів з донорськими порогами реєстр зберігає пороги договору з донором.</p><div class="rsteps"><span class="btn" onclick="showStep('PRC-05',2,true)">крок 2</span></div></div></div><div class="rule"><div class="rsrc"><span class="rdoc" style="background:#6A1B9A">Положення про порядок здійснення закупівель (редакція від 26.05.2026, наказ № 36-о від 25.05.2026)</span><span class="rref">розділ 2, пп. 2.1, 2.3, 2.5, 2.6</span></div><p class="rtxt">Тендерний комітет створюється наказом Голови правління; не менше трьох працівників; ініціатори — без права голосу; рішення простою більшістю; протокол підписують усі, хто голосував</p><div class="rapp"><span class="rl">У новому процесі</span><p>Кроки 5, 11, 13: склад наказом, оцінювання з правом голосу лише членів, підписи всіх, хто голосував.</p><div class="rsteps"><span class="btn" onclick="showStep('PRC-05',5,true)">крок 5</span><span class="btn" onclick="showStep('PRC-05',11,true)">крок 11</span><span class="btn" onclick="showStep('PRC-05',13,true)">крок 13</span></div></div></div><div class="rule"><div class="rsrc"><span class="rdoc" style="background:#6A1B9A">Положення про порядок здійснення закупівель (редакція від 26.05.2026, наказ № 36-о від 25.05.2026)</span><span class="rref">п. 9.1</span></div><p class="rtxt">Усі члени комітету підписують декларацію про відсутність конфлікту інтересів до початку роботи; член із конфліктом утримується від рішень</p><div class="rapp"><span class="rl">У новому процесі</span><p>Кроки 6–7: декларації формує система, підписують члени у Вчасно; система стежить за кількістю членів з правом голосу.</p><div class="rsteps"><span class="btn" onclick="showStep('PRC-05',6,true)">крок 6</span><span class="btn" onclick="showStep('PRC-05',7,true)">крок 7</span></div></div></div><div class="rule"><div class="rsrc"><span class="rdoc" style="background:#6A1B9A">Положення про порядок здійснення закупівель (редакція від 26.05.2026, наказ № 36-о від 25.05.2026)</span><span class="rref">пп. 3.3.1, 3.3.5</span></div><p class="rtxt">Оголошення містить опис предмета, очікувану вартість, строк подання, контакти, кваліфікаційні вимоги; періоди уточнень і подання — не менше 3 робочих днів</p><div class="rapp"><span class="rl">У новому процесі</span><p>Крок 2 задає строки; крок 3 — чернетка оголошення з обов&#x27;язковими елементами; крок 4 — оприлюднення.</p><div class="rsteps"><span class="btn" onclick="showStep('PRC-05',2,true)">крок 2</span><span class="btn" onclick="showStep('PRC-05',3,true)">крок 3</span><span class="btn" onclick="showStep('PRC-05',4,true)">крок 4</span></div></div></div><div class="rule"><div class="rsrc"><span class="rdoc" style="background:#6A1B9A">Положення про порядок здійснення закупівель (редакція від 26.05.2026, наказ № 36-о від 25.05.2026)</span><span class="rref">п. 3.3.3</span></div><p class="rtxt">Рішення про переможця ухвалюється, якщо надійшло не менше двох пропозицій; інакше тендер оголошується повторно</p><div class="rapp"><span class="rl">У новому процесі</span><p>Крок 10: перевірку кількості робить система і повертає процедуру на повторне оголошення.</p><div class="rsteps"><span class="btn" onclick="showStep('PRC-05',10,true)">крок 10</span></div></div></div><div class="rule"><div class="rsrc"><span class="rdoc" style="background:#6A1B9A">Положення про порядок здійснення закупівель (редакція від 26.05.2026, наказ № 36-о від 25.05.2026)</span><span class="rref">розділ 4, пп. 4.1–4.4</span></div><p class="rtxt">Оцінювання враховує відповідність вимогам, ціну, досвід, репутацію, строки; рішення колегіальне за сукупністю критеріїв</p><div class="rapp"><span class="rl">У новому процесі</span><p>Критерії — у формі оцінювання (крок 11); зведення балів — системою (крок 12).</p><div class="rsteps"><span class="btn" onclick="showStep('PRC-05',11,true)">крок 11</span><span class="btn" onclick="showStep('PRC-05',12,true)">крок 12</span></div></div></div><div class="rule"><div class="rsrc"><span class="rdoc" style="background:#6A1B9A">Положення про порядок здійснення закупівель (редакція від 26.05.2026, наказ № 36-о від 25.05.2026)</span><span class="rref">пп. 8.1, 1.8</span></div><p class="rtxt">Документація закупівлі зберігається не менше 5 років; донору на запит надаються оголошення, договір, протокол вибору переможця, документи переможця</p><div class="rapp"><span class="rl">У новому процесі</span><p>Крок 15: тека процедури архівується з повним пакетом.</p><div class="rsteps"><span class="btn" onclick="showStep('PRC-05',15,true)">крок 15</span></div></div></div><div class="rule"><div class="rsrc"><span class="rdoc" style="background:#0F6CBD">Гайд закупівель</span><span class="rref">слайд 10 «Закупівля від 2,5 млн грн — тендер», кроки 6–11</span></div><p class="rtxt">Протокол засідання комітету погоджують у Вчасно керівник проєкту, CFO, за предметом — CIO або Comms Lead; підписує Голова правління; учасники інформуються про результат</p><div class="rapp"><span class="rl">У новому процесі</span><p>Кроки 12–15: маршрут протоколу у Вчасно, підпис Голови правління, повідомлення учасників.</p><div class="rsteps"><span class="btn" onclick="showStep('PRC-05',12,true)">крок 12</span><span class="btn" onclick="showStep('PRC-05',13,true)">крок 13</span><span class="btn" onclick="showStep('PRC-05',14,true)">крок 14</span><span class="btn" onclick="showStep('PRC-05',15,true)">крок 15</span></div></div></div><div class="rule"><div class="rsrc"><span class="rdoc" style="background:#0F6CBD">Гайд закупівель</span><span class="rref">слайд 3 «Decision Tree»</span></div><p class="rtxt">Тендерна процедура застосовується для закупівель від 2,5 млн грн</p><div class="rapp"><span class="rl">У новому процесі</span><p>Крок 2 визначає тип процедури за сумою; пороги — за п. 1.11 чинного Положення; донорські пороги (п. 1.12) — окремим полем реєстру.</p><div class="rsteps"><span class="btn" onclick="showStep('PRC-05',2,true)">крок 2</span></div></div></div><div class="rule"><div class="rsrc"><span class="rdoc" style="background:#038387">Опис системи обліку закупівельних запитів</span><span class="rref">розділ 6 «Bucket-и Planner»</span></div><p class="rtxt">Задачі, що очікують погодження службових записок або тендерного протоколу, стоять у кошику «Очікує погодження»; закупівля вважається виконаною після підписаного акта</p><div class="rapp"><span class="rl">У новому процесі</span><p>Крок 15 переводить запит у статус «Оформлення та підписання документів»; закриття — після приймання (PRC-14).</p><div class="rsteps"><span class="btn" onclick="showStep('PRC-05',15,true)">крок 15</span></div></div></div></div><div class="rsources"><span class="rl">Джерела</span><div class="src"><b>Положення про порядок здійснення закупівель, редакція від 26.05.2026 (наказ № 36-о від 25.05.2026)</b><span>пороги, тендерний комітет, конфлікт інтересів, оголошення, строки, оцінювання, зберігання; редакція 2025 втратила чинність</span></div><div class="src"><b>Гайд закупівель (Procurement process guide, презентація)</b><span>слайди 3 і 10 — пороги і кроки тендеру</span></div><div class="src"><b>Опис системи обліку закупівельних запитів</b><span>статуси і кошики трекера</span></div><div class="src"><b>Картка процесу PRC-05 «Tender (&gt;2.5M)»</b><span>12 дій з оцінками часу; договір, оплата і отримання товару — інші процеси</span></div></div></div></details>
<details class="acc"><summary><span class="chev"></span><span class="at">Інструменти, ліцензії, вартість</span><span class="as">6 інструментів · Трекер закупівельних запитів, SharePoint і OneDrive, Microsoft Lists, Power Automate …</span></summary><div class="ab"><div class="tgrid"><div class="tcard"><div class="thead"><span class="tm big" style="background:#9CA3AF">Тр</span><div><b>Трекер закупівельних запитів</b><small>Forms, Lists, Planner, Power Automate</small></div></div><p>Запит, номер, реєстр закупівельних запитів, статуси до «Виконано»</p><div class="trow"><span class="lbl">Ліцензія</span><span>Стандартні з&#x27;єднання входять до Microsoft 365; система спроєктована в організації</span></div><div class="trow"><span class="lbl">Вартість</span><span>0 $</span></div><div class="trow"><span class="lbl">Етап плану</span><span>етап 2 — наявні ліцензії</span></div></div><div class="tcard"><div class="thead"><span class="tm big" style="background:#036C70">SP</span><div><b>SharePoint і OneDrive</b><small>тека процедури, запит файлів, архів</small></div></div><p>Документи тендеру, приймання пропозицій за посиланням, зберігання 5 років</p><div class="trow"><span class="lbl">Ліцензія</span><span>Входить до Microsoft 365; запити файлів має дозволити адміністратор</span></div><div class="trow"><span class="lbl">Вартість</span><span>0 $</span></div><div class="trow"><span class="lbl">Етап плану</span><span>етап 2 — наявні ліцензії</span></div></div><div class="tcard"><div class="thead"><span class="tm big" style="background:#038387">Li</span><div><b>Microsoft Lists</b><small>реєстр процедур, реєстр пропозицій, форми оцінювання</small></div></div><p>Строки, склад комітету, декларації, пропозиції, незалежні оцінки і зведення балів</p><div class="trow"><span class="lbl">Ліцензія</span><span>Входить до Microsoft 365</span></div><div class="trow"><span class="lbl">Вартість</span><span>0 $</span></div><div class="trow"><span class="lbl">Етап плану</span><span>етап 2 — наявні ліцензії</span></div></div><div class="tcard"><div class="thead"><span class="tm big" style="background:#0066FF">PA</span><div><b>Power Automate</b><small>автоматизації за правилами (у Microsoft їх називають потоками)</small></div></div><p>Простір тендеру, нагадування, перевірка кількості пропозицій, розсилка форм, зведення, документи у Вчасно</p><div class="trow"><span class="lbl">Ліцензія</span><span>Стандартні з&#x27;єднання входять до Microsoft 365; заповнення шаблонів Word і виклики API — Power Automate Premium</span></div><div class="trow"><span class="lbl">Вартість</span><span>≈ 3,75 $ на місяць за один обліковий запис автоматизації (ціна для неприбуткових організацій)</span></div><div class="trow"><span class="lbl">Етап плану</span><span>етап 3 — розширені ліцензії або ШІ, за окремим рішенням</span></div></div><div class="tcard"><div class="thead"><span class="tm big" style="background:#1F4B6E">Вч</span><div><b>Вчасно</b><small>підписи декларацій, наказу і протоколу; API за тарифом «Інтеграція»</small></div></div><p>КЕП членів комітету і Голови правління, внутрішнє погодження протоколу</p><div class="trow"><span class="lbl">Ліцензія</span><span>Підписка організації; облікові записи для членів комітету; для автоматичного завантаження — тариф «Інтеграція»</span></div><div class="trow"><span class="lbl">Вартість</span><span>тариф організації; «Інтеграція» — 7 200 грн на рік плюс 7,20 грн за документ</span></div><div class="trow"><span class="lbl">Етап плану</span><span>етап 2 — наявні ліцензії</span></div></div><div class="tcard"><div class="thead"><span class="tm big" style="background:#7B61FF">Cp</span><div><b>Copilot Studio</b><small>агент контрольних переліків з реєстру ШІ-агентів організації</small></div></div><p>Перелік документів і чернетка оголошення для тендеру (стадія за реєстром — пропозиція)</p><div class="trow"><span class="lbl">Ліцензія</span><span>Окрема оплата: кредити Copilot або оплата за використання через Azure</span></div><div class="trow"><span class="lbl">Вартість</span><span>пакет 25 000 кредитів — орієнтовно 200 $ на місяць, або оплата за використання</span></div><div class="trow"><span class="lbl">Етап плану</span><span>етап 3 — розширені ліцензії або ШІ, за окремим рішенням</span></div></div></div></div></details>
<details class="acc"><summary><span class="chev"></span><span class="at">Здійсненність і перевірки пілоту</span><span class="as">6 за документацією вендора · 1 потребує тестування</span></summary><div class="ab"><p class="sub">Позначки F — номери фактів у довіднику (розділ «Метод і довідник»). «Потребує тестування» — можливість підтверджена документацією, але її поведінку в середовищі організації перевіряє пілот. «Перевірено у тестовому середовищі» — крок відтворено на тестовому сайті Microsoft 365 тими самими вбудованими засобами.</p><div class="scroller"><table class="feas"><tr><th>Крок</th><th>Що робить система</th><th>На що спирається</th><th>Статус</th></tr><tr><td class="fn">2</td><td><b>Система визначає процедуру за сумою і створює робочий простір тендеру</b><p>Автоматизація за сумою визначає процедуру, створює теку SharePoint і запис реєстру процедур.</p></td><td><span class="fc" title="Forms, Lists (SharePoint), Planner, Teams, Office 365 Outlook, OneDrive for Business і Excel Online (Business) належать до стандартних конекторів Power Automate та включені до ліцензії Microsoft 365.">F001</span></td><td><span class="fs fs-ok">за документацією вендора</span><small>виробничий календар і конфігураційний список порогів (п. 1.11; донорські пороги — п. 1.12)</small></td></tr><tr><td class="fn">3</td><td><b>Агент готує контрольний перелік тендеру і чернетку оголошення за Положенням</b><p>Агент Copilot Studio зі знаннями з Положення готує контрольний перелік і чернетку оголошення; оплата кредитами.</p></td><td><span class="fc" title="Copilot Studio підтримує агентів зі знаннями з SharePoint і файлів, діями через конектори та каналами Teams, Microsoft 365 Copilot і веб, а також робочі процеси й агентні потоки.">F011</span><span class="fc" title="Стандартний агент дотримується інструкцій, використовує підключені джерела знань та інструменти для виконання дій; підтримує теми зі сценаріями й генеративну оркестрацію.">F074</span><span class="fc" title="Кредити купують пакетами Copilot Studio або оплачують за використання через підписку Azure; пакет 25 000 кредитів наведений як орієнтовно 200 $ на місяць.">F087</span></td><td><span class="fs fs-t">потребує тестування</span><small>етап 3; обсяг кредитів і якість чернеток перевіряються пілотом</small></td></tr><tr><td class="fn">6</td><td><b>Система надсилає членам комітету декларації про конфлікт інтересів на підпис у Вчасно</b><p>Декларації формуються з шаблону Word (преміум-дія) і надсилаються у Вчасно на підпис членам комітету.</p></td><td><span class="fc" title="Дії «Populate a Microsoft Word template» і «Convert Word Document to PDF» є преміум-діями Power Automate.">F003</span><span class="fc" title="Завантаження документа POST /api/v2/documents приймає параметри внутрішнього погодження (reviewers_ids або reviewers_emails — погоджувачі, parallel_review — паралельно чи почергово, is_required_review — заборона підпису ">F118</span><span class="fc" title="Тариф «Інтеграція» для юридичних осіб коштує 7 200 грн/рік плюс 7,20 грн за документ; для ФОП — 1 440 грн/рік.">F028</span></td><td><span class="fs fs-ok">за документацією вендора</span></td></tr><tr><td class="fn">8</td><td><b>Система відкриває приймання пропозицій, реєструє їх і нагадує про кінцевий строк</b><p>Запит файлів OneDrive приймає пропозиції від зовнішніх учасників; лист у скриньку закупівель запускає стандартний тригер Outlook; запис у реєстрі пропозицій.</p></td><td><span class="fc" title="Запит файлів дає зовнішній особі змогу завантажити файли до вибраної теки за посиланням, не бачачи її вмісту; до назви файла додається ім’я завантажувача.">F056</span><span class="fc" title="Конектор Office 365 Outlook — стандартний; тригер «When a new email arrives (V3)» працює опитуванням і фільтрує за текою, темою та наявністю вкладень; вміст вкладення повертає дія «Get Attachment (V2)».">F107</span><span class="fc" title="Forms, Lists (SharePoint), Planner, Teams, Office 365 Outlook, OneDrive for Business і Excel Online (Business) належать до стандартних конекторів Power Automate та включені до ліцензії Microsoft 365.">F001</span></td><td><span class="fs fs-ok">за документацією вендора</span><small>ідентифікатор подання, правила версій, права спільної скриньки</small></td></tr><tr><td class="fn">10</td><td><b>Після кінцевого строку система перевіряє кількість пропозицій і розсилає форми оцінювання</b><p>Після кінцевого строку автоматизація рахує пропозиції і надсилає членам комітету форми оцінювання (Lists) у Teams.</p></td><td><span class="fc" title="Forms, Lists (SharePoint), Planner, Teams, Office 365 Outlook, OneDrive for Business і Excel Online (Business) належать до стандартних конекторів Power Automate та включені до ліцензії Microsoft 365.">F001</span><span class="fc" title="Конектор Microsoft Teams — стандартний; дія «Post adaptive card and wait for a response» публікує картку у чат або канал і чекає відповіді користувача; дія «Post message in a chat or channel» надсилає повідомлення.">F111</span><span class="fc" title="Форма створюється безпосередньо зі списку Lists (кнопка «Форми» на панелі списку або зі стартової сторінки Lists), а надіслані відповіді одразу стають записами списку без Power Automate; для одного списку можна створити ">F052</span></td><td><span class="fs fs-ok">за документацією вендора</span><small>форми Lists доступні лише користувачам організації (зовнішні заявники — через інші канали)</small></td></tr><tr><td class="fn">12</td><td><b>Система зводить оцінки і голоси, формує протокол засідання і надсилає його на підпис</b><p>Автоматизація зводить оцінки, заповнює шаблон протоколу Word і завантажує його у Вчасно на підпис.</p></td><td><span class="fc" title="Дії «Populate a Microsoft Word template» і «Convert Word Document to PDF» є преміум-діями Power Automate.">F003</span><span class="fc" title="Завантаження документа POST /api/v2/documents приймає параметри внутрішнього погодження (reviewers_ids або reviewers_emails — погоджувачі, parallel_review — паралельно чи почергово, is_required_review — заборона підпису ">F118</span></td><td><span class="fs fs-ok">за документацією вендора</span></td></tr><tr><td class="fn">15</td><td><b>Система повідомляє учасників, передає закупівлю на договір і архівує теку процедури</b><p>Повідомлення учасникам через Outlook, запис для процесу договору, архів у SharePoint — стандартні конектори.</p></td><td><span class="fc" title="Конектор Office 365 Outlook — стандартний; тригер «When a new email arrives (V3)» працює опитуванням і фільтрує за текою, темою та наявністю вкладень; вміст вкладення повертає дія «Get Attachment (V2)».">F107</span><span class="fc" title="Forms, Lists (SharePoint), Planner, Teams, Office 365 Outlook, OneDrive for Business і Excel Online (Business) належать до стандартних конекторів Power Automate та включені до ліцензії Microsoft 365.">F001</span></td><td><span class="fs fs-ok">за документацією вендора</span><small>зберігання 5 років — окремий контроль</small></td></tr></table></div><h4>Що перевірити першими у пілоті</h4><ol class="clean"><li>подання однієї багатофайлової пропозиції і заміна версії</li><li>приватність індивідуальних оцінок у Lists (бачить лише автор) і підписи членів комітету як окремих осіб</li><li>повний протокол і пакет підписів у Вчасно</li></ol></div></details>
<details class="acc"><summary><span class="chev"></span><span class="at">Питання до організації</span><span class="as">5 питань</span></summary><div class="ab"><ol class="clean"><li>Чи є окреме Положення про тендерний комітет, на яке посилається п. 2.2 Положення про закупівлі?</li><li>Чи мають члени тендерного комітету облікові записи у Вчасно або власний КЕП для підпису декларацій і протоколу?</li><li>Чи дозволені в середовищі Microsoft 365 запити файлів і посилання «Будь-хто» для приймання пропозицій?</li><li>Де оприлюднюються оголошення — на сайті організації чи на майданчику, і хто це робить?</li><li>Чи є чинні договори з донорами, що встановлюють власні пороги процедур (п. 1.12 Положення), які реєстр має застосовувати замість загальних?</li></ol></div></details>
</main></div><details><summary>Джерело картки</summary><p><small>PRC-05 — книга Procurment processes.xlsx, аркуш «Tender (&gt;2.5M)» (назва у джерелі: «Full Tender Procurement (&gt;$2.5M)»).</small></p><ul></ul></details></article><article class="proc hidden" id="p-PRC-06"><div class="ptitle"><h2><span class="chip S">стандартний</span> PRC-06 — Закупівля за винятковою (переговорною) процедурою</h2><div class="strip"><div class="kpi txt"><b>Закупівлі</b><small>напрям</small></div><div class="kpi txt"><b>Фахівець із закупівель</b><small>відповідальна роль</small></div><div class="kpi txt"><b>T5 · конкурсна процедура</b><small>типова схема</small></div><div class="kpi txt"><b>впроваджувати першими</b><small>пріоритет: вплив високий, складність низька</small></div><div class="kpi"><b>8</b><small>дій у картці</small></div><div class="kpi"><b>3</b><small>ролей з діями</small></div><div class="kpi"><b>225 / 3 180</b><small>робота / тривалість, хв (оцінка організації)</small></div></div></div><div class="card pass"><div class="pgrid"><div class="pf"><span class="rl">Клієнт процесу</span><b>керівник проєкту</b></div><div class="pf"><span class="rl">Виконавець</span><b>Фахівець із закупівель і Голова правління</b></div><div class="pf"><span class="rl">Вхід</span><b>Службова записка з обґрунтуванням винятку</b></div><div class="pf"><span class="rl">Вихід</span><b>Погоджена закупівля за винятковою процедурою</b></div><div class="pf"><span class="rl">Контрольний перелік</span><b>підставу винятку задокументовано за п. 3.5 Положення; службову записку з обґрунтуванням перевірено; рішення Голови правління зафіксовано; пакет документів для аудиту збережено; запис закрито (за цільовою моделлю; підтвердити з власником процесу)</b></div><div class="pf"><span class="rl">Час за карткою</span><b>робота 225 хв · тривалість 3 180 хв</b></div><div class="pf"><span class="rl">Системи зараз</span><b>не зафіксовано у джерелі; підтвердити з власником процесу</b></div><div class="pf"><span class="